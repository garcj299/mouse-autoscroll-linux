#!/usr/bin/python3
# Launcher: runs the package from this repo (works through a symlink in ~/.local/bin).
# System python on purpose: python-evdev and python-pyudev come from pacman.
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
from mouse_autoscroll.main import main  # noqa: E402

sys.exit(main())
